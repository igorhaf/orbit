#!/usr/bin/env bash
# =============================================================================
# ORBIT - Native WSL2 Service Manager
# =============================================================================
# Usage: orbit <command> [service]
#
# Commands:
#   install              Install all dependencies (PostgreSQL, Redis, Python, Node)
#   setup                Configure databases, .env, app dependencies, migrations
#   start [service]      Start all services or a specific one
#   stop [service]       Stop all services or a specific one
#   restart [service]    Restart all services or a specific one
#   status               Show status of all services
#   logs [service]       Show logs (backend|frontend|all, -f for follow)
#   db:migrate           Run Alembic migrations
#   db:reset             Drop and recreate database + migrations
#   nuke                 Kill everything hard + restart all services
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Paths & Constants
# ---------------------------------------------------------------------------
ORBIT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND_DIR="${ORBIT_ROOT}/backend"
FRONTEND_DIR="${ORBIT_ROOT}/frontend"
MODULES_DIR="${ORBIT_ROOT}/scripts/orbit.d"
PID_DIR="/tmp/orbit"
LOG_DIR="/tmp/orbit"

BACKEND_PID="${PID_DIR}/backend.pid"
FRONTEND_PID="${PID_DIR}/frontend.pid"
BACKEND_LOG="${LOG_DIR}/backend.log"
FRONTEND_LOG="${LOG_DIR}/frontend.log"

DB_USER="orbit"
DB_PASS="orbit_password"
DB_NAME="orbit"
DB_NAME_LEGACY="ai_orchestrator"

SUDO_PASS="30102024@Real"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()    { echo -e "${BLUE}ℹ${NC}  $*"; }
success() { echo -e "${GREEN}✔${NC}  $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
error()   { echo -e "${RED}✖${NC}  $*"; }
header()  { echo -e "\n${BOLD}${CYAN}━━━ $* ━━━${NC}\n"; }

sudo_run() {
    echo "$SUDO_PASS" | sudo -S "$@" 2>/dev/null
}

ensure_dirs() {
    mkdir -p "$PID_DIR" "$LOG_DIR"
}

get_windows_ip() {
    local gw
    gw=$(ip route show default 2>/dev/null | awk '{print $3}')
    if [[ -n "$gw" ]]; then
        echo "$gw"
    else
        grep -m1 nameserver /etc/resolv.conf 2>/dev/null | awk '{print $2}' || echo "localhost"
    fi
}

# ---------------------------------------------------------------------------
# Service Checks
# ---------------------------------------------------------------------------
is_pg_running() {
    sudo_run service postgresql status >/dev/null 2>&1
}

is_redis_running() {
    sudo_run service redis-server status >/dev/null 2>&1
}

is_backend_running() {
    if [[ -f "$BACKEND_PID" ]]; then
        local pid
        pid=$(cat "$BACKEND_PID")
        kill -0 "$pid" 2>/dev/null && return 0
        rm -f "$BACKEND_PID"
    fi
    return 1
}

is_frontend_running() {
    if [[ -f "$FRONTEND_PID" ]]; then
        local pid
        pid=$(cat "$FRONTEND_PID")
        kill -0 "$pid" 2>/dev/null && return 0
        rm -f "$FRONTEND_PID"
    fi
    return 1
}

is_ollama_reachable() {
    local win_ip
    win_ip=$(get_windows_ip)
    curl -sf "http://${win_ip}:11434/api/version" >/dev/null 2>&1
}

check_port() {
    ss -tlnp 2>/dev/null | grep -q ":$1 " 2>/dev/null
}

_kill_tree() {
    local parent_pid="$1"
    local child_pids
    child_pids=$(pgrep -P "$parent_pid" 2>/dev/null || true)
    for cpid in $child_pids; do
        _kill_tree "$cpid"
    done
    kill -9 "$parent_pid" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
cmd_help() {
    echo -e "${BOLD}${CYAN}"
    echo "   ____  _____  ____ _____ _______"
    echo "  / __ \\|  __ \\|  _ \\_   _|__   __|"
    echo " | |  | | |__) | |_) || |    | |"
    echo " | |  | |  _  /|  _ < | |    | |"
    echo " | |__| | | \\ \\| |_) || |_   | |"
    echo "  \\____/|_|  \\_\\____/_____|  |_|"
    echo -e "${NC}"
    echo -e "  ${BOLD}Native WSL2 Service Manager${NC}"
    echo ""
    echo -e "  ${BOLD}Usage:${NC} orbit <command> [service]"
    echo ""
    echo -e "  ${BOLD}Commands:${NC}"
    echo -e "    ${GREEN}install${NC}              Install all dependencies (PostgreSQL, Redis, Python, Node)"
    echo -e "    ${GREEN}setup${NC}                Configure databases, .env, app dependencies, migrations"
    echo -e "    ${GREEN}start${NC}   [service]    Start all or specific service"
    echo -e "    ${GREEN}stop${NC}    [service]    Stop all or specific service"
    echo -e "    ${GREEN}restart${NC} [service]    Restart all or specific service"
    echo -e "    ${GREEN}status${NC}               Show status of all services"
    echo -e "    ${GREEN}logs${NC}    [service]    Show logs (backend|frontend|all, default: all)"
    echo -e "    ${GREEN}db:migrate${NC}           Run Alembic migrations"
    echo -e "    ${GREEN}db:reset${NC}             Drop + recreate database + run migrations"
    echo -e "    ${GREEN}nuke${NC}                 Kill everything hard + restart all services"
    echo ""
    echo -e "  ${BOLD}Services:${NC}"
    echo -e "    postgres (pg, db)    PostgreSQL 16 + pgvector"
    echo -e "    redis                Redis cache"
    echo -e "    backend (api)        FastAPI backend (port 8000)"
    echo -e "    frontend (web)       Next.js frontend (port 3000)"
    echo ""
    echo -e "  ${BOLD}Examples:${NC}"
    echo -e "    orbit install          # First-time setup"
    echo -e "    orbit setup            # Configure everything"
    echo -e "    orbit start            # Start all services"
    echo -e "    orbit start backend    # Start only backend"
    echo -e "    orbit status           # Check all services"
    echo -e "    orbit logs             # View all logs (summary)"
    echo -e "    orbit logs backend -f  # Follow mode"
    echo -e "    orbit logs backend 200 # Last 200 lines"
    echo -e "    orbit stop             # Stop everything"
    echo ""
}

# =============================================================================
# MAIN - Source modules on demand and dispatch
# =============================================================================
main() {
    local command="${1:-help}"
    shift 2>/dev/null || true

    case "$command" in
        install)
            source "${MODULES_DIR}/install.sh"
            cmd_install "$@"
            ;;
        setup)
            source "${MODULES_DIR}/setup.sh"
            cmd_setup "$@"
            ;;
        start)
            source "${MODULES_DIR}/start.sh"
            source "${MODULES_DIR}/status.sh"
            cmd_start "$@"
            ;;
        stop)
            source "${MODULES_DIR}/stop.sh"
            cmd_stop "$@"
            ;;
        restart)
            source "${MODULES_DIR}/start.sh"
            source "${MODULES_DIR}/stop.sh"
            source "${MODULES_DIR}/status.sh"
            source "${MODULES_DIR}/restart.sh"
            cmd_restart "$@"
            ;;
        status)
            source "${MODULES_DIR}/status.sh"
            cmd_status "$@"
            ;;
        logs)
            source "${MODULES_DIR}/logs.sh"
            cmd_logs "$@"
            ;;
        db:migrate)
            source "${MODULES_DIR}/start.sh"
            source "${MODULES_DIR}/db.sh"
            cmd_db_migrate "$@"
            ;;
        db:reset)
            source "${MODULES_DIR}/start.sh"
            source "${MODULES_DIR}/stop.sh"
            source "${MODULES_DIR}/db.sh"
            cmd_db_reset "$@"
            ;;
        nuke)
            source "${MODULES_DIR}/start.sh"
            source "${MODULES_DIR}/stop.sh"
            source "${MODULES_DIR}/status.sh"
            source "${MODULES_DIR}/nuke.sh"
            cmd_nuke "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
