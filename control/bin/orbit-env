#!/usr/bin/env python3
"""Host entry point; the Docker administration logic runs inside CONTROL."""
import os
import shlex
import subprocess
import sys

command = ['docker', 'exec', 'orbit-control', '/usr/local/bin/orbit-env', *sys.argv[1:]]
if subprocess.run(['docker', 'info'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
    os.execvp(command[0], command)
os.execvp('sg', ['sg', 'docker', '-c', shlex.join(command)])
