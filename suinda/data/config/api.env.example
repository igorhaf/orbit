JWT_SECRET=replace-with-a-long-random-secret
ORBIT_SECRET_KEY=replace-with-a-long-random-secret
VAULT_ENCRYPTION_KEY=replace-with-a-long-random-secret
# WEB_ORIGIN deve acompanhar a origem pública da interface quando usada em staging/produção.
# API_PUBLIC_URL é fornecida pelo Compose a partir de SUINDA_API_PUBLIC_URL no arquivo .env da raiz.
# WEB_ORIGIN=http://localhost:3003
# Encrypt declared personal fields in versioned records; generate a dedicated key with: openssl rand -hex 32
ORBIT_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Set the former key here only during a documented rotation.
# ORBIT_DATA_ENCRYPTION_KEY_PREVIOUS=
ORBIT_BACKUP_KEY=replace-with-a-64-character-hex-key
# Encrypt generic workspace webhook signing secrets at rest. Generate with: openssl rand -hex 32
ORBIT_WEBHOOK_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
# Optional account verification and password reset:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# Optional login social (OIDC). Register https://<API_HOST>/auth/social/google/callback.
# The callback is formed from API_PUBLIC_URL in compose configuration.
# ORBIT_SOCIAL_PROVIDERS=google
# ORBIT_OAUTH_GOOGLE_CLIENT_ID=
# ORBIT_OAUTH_GOOGLE_CLIENT_SECRET=
# ORBIT_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# Optional Apple Sign in uses a generated client_secret JWT; rotate it before expiry.
# ORBIT_OAUTH_APPLE_CLIENT_ID=<services-id>
# ORBIT_OAUTH_APPLE_CLIENT_SECRET=<signed-client-secret-jwt>
# ORBIT_OAUTH_APPLE_ISSUER=https://appleid.apple.com
# Zoom OAuth app for teacher-created online meetings; register this callback in Zoom Marketplace.
# Grant meeting:write, meeting:read and user:read. Each teacher authorizes their own account.
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4004/zoom/oauth/callback
# Independent HMAC key for the approved erasure ledger; keep separate from database backups.
ORBIT_ERASURE_LEDGER_KEY=replace-with-a-64-character-hex-key
# Optional explicit location on a persistent volume (defaults to ORBIT_BACKUP_DIR).
# ORBIT_ERASURE_LEDGER_PATH=/data/backups/approved-erasures.v1.jsonl
