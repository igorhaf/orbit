[Unit]
Description=Orbit development memory metadata collector (48 hours)

[Service]
Type=simple
WorkingDirectory=%h/projetos/orbit/dev/app
ExecStart=/usr/bin/python3 %h/projetos/orbit/dev/app/tools/dev-runtime/monitor.py --output %h/projetos/orbit/control/state/ram-20261101/samples.jsonl --interval 60 --duration 172800
ExecStopPost=/usr/bin/python3 %h/projetos/orbit/dev/app/tools/dev-runtime/observation-summary.py --input %h/projetos/orbit/control/state/ram-20261101/samples.jsonl --output-prefix %h/projetos/orbit/control/state/ram-20261101/observation-followup
RuntimeMaxSec=49h
MemoryMax=128M
CPUQuota=10%
Restart=no
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
