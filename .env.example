DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
JWT_SECRET=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave empty to use the same-origin proxy (works from phones on the LAN).
NEXT_PUBLIC_API_URL=
ORBIT_NATIVE_ROOT=/home/meada/projetos/orbit-dev
ORBIT_STABLE_ROOT=/home/meada/projetos/orbit

# Encrypts provider credentials at rest. Use an independent random secret in production.
ORBIT_SECRET_KEY=

# Encrypted, verified PostgreSQL backups. Keep this key in a password manager
# outside the Orbit server; losing it makes backup archives unrecoverable.
ORBIT_BACKUP_KEY=
ORBIT_BACKUP_DIR=
ORBIT_BACKUP_KEEP=30
ORBIT_RESTORE_DATABASE_URL=
# Google Drive OAuth refresh credentials; use a dedicated OAuth client and folder.
ORBIT_DRIVE_CLIENT_ID=
ORBIT_DRIVE_CLIENT_SECRET=
ORBIT_DRIVE_REFRESH_TOKEN=
ORBIT_DRIVE_FOLDER_ID=

# GitHub App and OAuth integration. The app private key accepts escaped newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Dropbox. Create a scoped OAuth app and register this exact callback URL.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:4000/dropbox/oauth/callback

# Google Calendar provider. Register the callback URL in Google Cloud OAuth.
API_PUBLIC_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/calendar/google/oauth/callback
# Events.watch requires a publicly reachable HTTPS endpoint ending in /calendar/google/webhook.
GOOGLE_CALENDAR_WEBHOOK_URL=

# Shared Microsoft 365 connection for Outlook Calendar, Outlook Mail and Teams.
# Register the callback in Microsoft Entra ID. The webhook must be public HTTPS.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/calendar/microsoft/oauth/callback
MICROSOFT_GRAPH_WEBHOOK_URL=

# Trello polling mirror. Keep key/token server-side only. TRELLO_CONFIG_PATH
# can point at an existing local environment that owns the credentials.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_CONFIG_PATH=
TRELLO_DEFAULT_BOARD_ID=
TRELLO_DEFAULT_ORBIT_BOARD_ID=
TRELLO_SYNC_INTERVAL_MS=5000

# Reports use SMTP. Pending mail remains visible in automation logs without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_INGEST_TOKEN=
COMMENT_EMAIL_DOMAIN=

# Optional independent encryption key for the Orbit vault.
VAULT_ENCRYPTION_KEY=

# Optional card executor: uses the server user's existing Codex login.
CODEX_BIN=codex
CODEX_AI_TIMEOUT_MS=90000
ORBIT_EXECUTION_TIMEOUT_MS=300000
