DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
JWT_SECRET=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave empty to use the same-origin proxy (works from phones on the LAN).
NEXT_PUBLIC_API_URL=
ORBIT_NATIVE_ROOT=/home/meada/projetos/orbit-dev
ORBIT_DEVELOPMENT_ROOT=/home/meada/projetos/orbit-dev

# Instância de desenvolvimento: use 3001/4001 para coexistir com o Orbit principal.
# A cópia principal usa os valores 3000/4000 acima.
ORBIT_API_PROXY_URL=http://127.0.0.1:4000
# Optional: set THEME=dark to force dark mode for this app instance.
# Leave unset to use each account's saved theme preference.
THEME=

# Encrypts provider credentials at rest. Use an independent random secret in production.
ORBIT_SECRET_KEY=
# Keep the previous integration key here during and after rotation until all old ciphertexts are migrated.
ORBIT_SECRET_KEY_PREVIOUS=

# Encrypted, verified PostgreSQL backups. Keep this key in a password manager
# outside the Orbit server; losing it makes backup archives unrecoverable.
ORBIT_BACKUP_KEY=
ORBIT_BACKUP_DIR=
ORBIT_BACKUP_KEEP=30
ORBIT_RESTORE_DATABASE_URL=
# Separate HMAC key for approved-erasure tombstones; preserve independently of database archives.
ORBIT_ERASURE_LEDGER_KEY=
ORBIT_ERASURE_LEDGER_PATH=
# Google Drive OAuth refresh credentials; use a dedicated OAuth client and folder.
ORBIT_DRIVE_CLIENT_ID=
ORBIT_DRIVE_CLIENT_SECRET=
ORBIT_DRIVE_REFRESH_TOKEN=
ORBIT_DRIVE_FOLDER_ID=

# GitHub App and OAuth integration. The app private key accepts escaped newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Encrypts generic workspace webhook signing secrets at rest. Generate with:
# openssl rand -hex 32
ORBIT_WEBHOOK_ENCRYPTION_KEY=

# Dropbox. Create a scoped OAuth app and register this exact callback URL.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:4000/dropbox/oauth/callback

# Google Calendar provider. Register the callback URL in Google Cloud OAuth.
API_PUBLIC_URL=http://localhost:4000
# Optional OpenID Connect sign-in. Register each callback exactly as
# {API_PUBLIC_URL}/auth/social/{provider}/callback. The Orbit account must
# already exist with a verified matching email address.
ORBIT_SOCIAL_PROVIDERS=
ORBIT_OAUTH_GOOGLE_CLIENT_ID=
ORBIT_OAUTH_GOOGLE_CLIENT_SECRET=
ORBIT_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# For Microsoft Entra, set the tenant-specific issuer, e.g.
# https://login.microsoftonline.com/{tenant-id}/v2.0 and add microsoft to the provider list.
ORBIT_OAUTH_MICROSOFT_CLIENT_ID=
ORBIT_OAUTH_MICROSOFT_CLIENT_SECRET=
ORBIT_OAUTH_MICROSOFT_ISSUER=
ORBIT_OAUTH_APPLE_CLIENT_ID=
# Apple accepts a client_secret JWT signed with the private key created for the Services ID.
ORBIT_OAUTH_APPLE_CLIENT_SECRET=
ORBIT_OAUTH_APPLE_ISSUER=https://appleid.apple.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/calendar/google/oauth/callback
# Suindá Google Drive Picker. Restrict the browser API key to the institution's HTTPS web origins.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# OpenAI Audio Transcriptions for teacher-reviewed lesson media (optional). Keep server-side only.
OPENAI_API_KEY=
SUINDA_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/suinda-google-drive/oauth/callback
# Events.watch requires a publicly reachable HTTPS endpoint ending in /calendar/google/webhook.
GOOGLE_CALENDAR_WEBHOOK_URL=

# Shared Microsoft 365 connection for Outlook Calendar, Outlook Mail and Teams.
# Register the callback in Microsoft Entra ID. The webhook must be public HTTPS.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/calendar/microsoft/oauth/callback
MICROSOFT_GRAPH_WEBHOOK_URL=

# Zoom Server-side OAuth application. Register this callback in Zoom Marketplace.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4000/zoom/oauth/callback

# Trello polling mirror. Keep key/token server-side only. TRELLO_CONFIG_PATH
# can point at an existing local environment that owns the credentials.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_CONFIG_PATH=
TRELLO_DEFAULT_BOARD_ID=
TRELLO_DEFAULT_ORBIT_BOARD_ID=
TRELLO_SYNC_INTERVAL_MS=5000

# Reports use SMTP. Pending mail remains visible in automation logs without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_INGEST_TOKEN=
COMMENT_EMAIL_DOMAIN=

# Optional Web Push (VAPID). Leave all three blank to disable browser push delivery.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Optional independent encryption key for the Orbit vault.
VAULT_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY_PREVIOUS=

# Required to write protected academic profile fields (AES-256-GCM); keep outside backups.
# Rotate by setting the new key here and the former value in ORBIT_DATA_ENCRYPTION_KEY_PREVIOUS.
ORBIT_DATA_ENCRYPTION_KEY=
ORBIT_DATA_ENCRYPTION_KEY_PREVIOUS=

# Optional card executor: uses the server user's existing Codex login.
CODEX_BIN=codex
CODEX_AI_TIMEOUT_MS=90000
# Optional Orbit wide semantic retrieval. Requires an explicitly separate API key;
# lesson and query text are sent to OpenAI only when this flag is true.
ORBIT_AI_EMBEDDINGS_ENABLED=false
ORBIT_OPENAI_EMBEDDINGS_API_KEY=
ORBIT_EXECUTION_TIMEOUT_MS=300000
# Request limits are independent per operation, user/email, and network origin.
ORBIT_RATE_LIMIT_RECOVERY_IDENTITY=5
ORBIT_RATE_LIMIT_RECOVERY_ORIGIN=20
ORBIT_RATE_LIMIT_LOGIN_IDENTITY=30
ORBIT_RATE_LIMIT_LOGIN_ORIGIN=180
ORBIT_RATE_LIMIT_COMPLETE_IDENTITY=5
ORBIT_RATE_LIMIT_COMPLETE_ORIGIN=50
ORBIT_RATE_LIMIT_INVITATION_IDENTITY=20
ORBIT_RATE_LIMIT_INVITATION_ORIGIN=100
ORBIT_RATE_LIMIT_UPLOAD_IDENTITY=30
ORBIT_RATE_LIMIT_UPLOAD_ORIGIN=120
ORBIT_RATE_LIMIT_SEARCH_IDENTITY=60
ORBIT_RATE_LIMIT_SEARCH_ORIGIN=300
ORBIT_RATE_LIMIT_ALEXA_ORIGIN=120
# Set only to the proxy CIDRs that connect directly to this API; otherwise leave empty.
ORBIT_TRUSTED_PROXY_CIDRS=
# Opcional: expose uma pasta do host dentro do container e configure os dois caminhos.
# Exemplo: host /home/meada/projetos -> container /host-projects.
ORBIT_HOST_PROJECTS_ROOT=
ORBIT_CONTAINER_PROJECTS_ROOT=
# Optional Orbit document scanner. Prefer the private ClamD TCP endpoint when using
# a dedicated scanner service; otherwise set the executable path. Scholarship uploads
# require a clean scan; other attachment flows retain their not_configured behavior.
ORBIT_DOCUMENT_SCANNER_URL=
ORBIT_DOCUMENT_SCANNER_BIN=
