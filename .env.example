DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
JWT_SECRET=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave empty to use the same-origin proxy (works from phones on the LAN).
NEXT_PUBLIC_API_URL=

# Trello polling mirror. Keep key/token server-side only. TRELLO_CONFIG_PATH
# can point at an existing local environment that owns the credentials.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_CONFIG_PATH=
TRELLO_DEFAULT_BOARD_ID=
TRELLO_DEFAULT_ORBIT_BOARD_ID=
TRELLO_SYNC_INTERVAL_MS=5000

# Reports use SMTP. Pending mail remains visible in automation logs without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
