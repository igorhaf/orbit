{
  "name": "orbit",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "orbit:serve": "node scripts/orbit-manager.mjs",
    "orbit:dev": "node scripts/orbit-dev-manager.mjs",
    "orbit:rebuild-dev": "node scripts/orbit-rebuild-dev.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "lint:fix": "npm run lint:fix -w apps/api && npm run lint:fix -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "test:selenium:card-click": "node .orbit/validations/card-click/card-click.selenium.mjs",
    "test:selenium:calendar-card": "node .orbit/validations/calendar-card/calendar-card.selenium.mjs",
    "test:selenium:vault": "node .orbit/validations/vault-journey/vault-journey.selenium.mjs",
    "test:unit": "npm test -w apps/api",
    "db:backup": "npm run db:backup -w apps/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "selenium-webdriver": "^4.50.0",
    "typescript-eslint": "^8.70.1"
  }
}
